<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app APK updates: lets the package installer overwrite the app (Android 8+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- P2P sync (mDNS): Android's Wi-Fi driver drops multicast packets unless
         the app holds a MulticastLock — which needs these two permissions.
         Without them the phone can neither discover nor answer desktop peers. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- P2P background sync: the foreground SyncService keeps the Rust sync
         stack alive while the app is backgrounded (issue #60). dataSync is a
         normal (install-time) permission required from API 34;
         POST_NOTIFICATIONS is runtime — without the grant the service still
         runs, only its notification stays hidden (Android 13+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.enclave"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Native Keep-like shell (Compose): the app's front door. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:name=".KeepActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WebView editor island (Tauri): opened from the native shell for
             whiteboards, tables and databases. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <receiver
          android:name=".EnclaveWidget"
          android:exported="true"
          android:label="@string/app_name">
          <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
          </intent-filter>
          <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/widget_info" />
        </receiver>

        <!-- Keeps the sync stack alive while backgrounded; started/stopped
             from the Rust core via JNI as sync is enabled/disabled. -->
        <service
          android:name=".SyncService"
          android:exported="false"
          android:foregroundServiceType="dataSync" />
    </application>
</manifest>
